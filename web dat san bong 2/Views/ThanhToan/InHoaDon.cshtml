@model web_dat_san_bong_2.Models.HoaDon

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <title>Hóa đơn</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

</head>

<body onload="window.print()">

    <div class="container mt-5">

        <h2 class="text-center">

            HÓA ĐƠN THANH TOÁN

        </h2>

        <hr />

        <table class="table">

            <tr>

                <th>Mã hóa đơn</th>

                <td>@Model.MaHoaDon</td>

            </tr>

            <tr>

                <th>Sân</th>

                <td>

                    @Model.MaDatSanNavigation.MaSanNavigation.TenSan

                </td>

            </tr>

            <tr>

                <th>Ngày chơi</th>

                <td>

                    @Model.MaDatSanNavigation.NgayChoi

                </td>

            </tr>

            <tr>

                <th>Tổng tiền</th>

                <td>

                    @String.Format("{0:N0}", Model.TongTien)

                    VNĐ

                </td>

            </tr>

        </table>

    </div>

</body>

</html>