@model IEnumerable<web_dat_san_bong_2.Models.DiemTichLuy>

@{
    ViewData["Title"] = "Tích điểm thành viên";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-dark" style="max-width: 900px; margin: 0 auto;">
        <div class="card-body p-4">

            <h5 class="mb-4">Tích điểm thành viên </h5>

            <table class="table table-bordered table-striped align-middle">
                <thead style="background-color: #1a5b75; color: white;">
                    <tr>
                        <th class="text-center" style="width: 10%; border-color: #1a5b75;">STT</th>
                        <th style="width: 20%; border-color: #1a5b75;">Mã KH</th>
                        <th style="width: 40%; border-color: #1a5b75;">Tên TK</th>
                        <th class="text-center" style="width: 30%; border-color: #1a5b75;">Điểm tích lũy</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@stt</td>

                                <td>KH-@item.MaNguoiDung</td>

                                <td>
                                    @(item.MaNguoiDungNavigation != null
                                        ? (string.IsNullOrEmpty(item.MaNguoiDungNavigation.HoTen) ? item.MaNguoiDungNavigation.SoDienThoai : item.MaNguoiDungNavigation.HoTen)
                                        : "N/A")
                                </td>

                                <td class="text-center fw-bold text-primary">
                                    @item.TongDiem
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Chưa có dữ liệu điểm tích lũy.</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>