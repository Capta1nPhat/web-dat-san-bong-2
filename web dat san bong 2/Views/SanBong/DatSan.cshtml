@model web_dat_san_bong_2.Models.SanTheThao

@{
    ViewData["Title"] = "Đặt sân";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>Đặt sân</h3>

        </div>

        <div class="card-body">

            <h4>@Model.TenSan</h4>

            <p>Loại sân: @Model.LoaiSan</p>

            <p>Địa chỉ: @Model.DiaChi</p>

            <hr />

            <form asp-action="LuuDatSan" method="post">

                <input type="hidden"
                       name="MaSan"
                       value="@Model.MaSan" />

                <div class="mb-3">

                    <label class="form-label">

                        Ngày chơi

                    </label>

                    <input type="date"
                           class="form-control"
                           name="NgayChoi"
                           required />

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label>Giờ bắt đầu</label>

                        <select name="GioBatDau"
                                class="form-select"
                                required>

                            @for (int h = 6; h <= 22; h++)
                            {
                                <option value="@($"{h}:00")">
                                    @($"{h}:00")
                                </option>

                                if (h != 22)
                                {
                                    <option value="@($"{h}:30")">
                                        @($"{h}:30")
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label>Giờ kết thúc</label>

                        <select name="GioKetThuc"
                                class="form-select"
                                required>

                            @for (int h = 7; h <= 23; h++)
                            {
                                <option value="@($"{h}:00")">
                                    @($"{h}:00")
                                </option>

                                if (h != 23)
                                {
                                    <option value="@($"{h}:30")">
                                        @($"{h}:30")
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>

                <br />

                <button class="btn btn-success">

                    Tiếp tục thanh toán

                </button>

            </form>

        </div>

    </div>

</div>