@model web_dat_san_bong_2.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-page-container">
    <div class="auth-card text-center">

        <div class="auth-logo-circle shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <h3 class="fw-bold mb-2">Đăng ký</h3>
        <p class="text-muted mb-3" style="font-size: 0.9rem;">Tạo tài khoản để đặt sân dễ dàng hơn</p>

        <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill" style="font-size: 0.8rem; border: 1px solid #d1e7dd;">
                <i class="bi bi-check2"></i> Đặt sân nhanh
            </span>
            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill" style="font-size: 0.8rem; border: 1px solid #d1e7dd;">
                <i class="bi bi-check2"></i> Xem lịch sử
            </span>
            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill" style="font-size: 0.8rem; border: 1px solid #d1e7dd;">
                <i class="bi bi-check2"></i> Nhận ưu đãi
            </span>
        </div>
        @if (ViewBag.Loi != null)
        {
            <div class="alert alert-danger fw-bold text-center shadow-sm mb-4" style="border-left: 5px solid red; background-color: #ffe6e6; color: #cc0000; padding: 15px;">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i> @ViewBag.Loi
            </div>
        }

        <form asp-controller="Auth" asp-action="Register" method="post">

            <div class="mb-3 text-start">
                <div class="input-group input-group-custom">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="FullName" class="form-control" placeholder="Họ và tên *" required>
                </div>
                <span asp-validation-for="FullName" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-3 text-start">
                <div class="input-group input-group-custom">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Phone" type="tel" class="form-control" placeholder="Số điện thoại *" required pattern="[0-9]{10,11}" title="Vui lòng nhập 10-11 chữ số">
                </div>
                <span asp-validation-for="Phone" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-3 text-start">
                <div class="input-group input-group-custom">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Email (chỉ hỗ trợ @@gmail.com)" pattern="^[a-zA-Z0-9._%+\-]+@@gmail\.com$" title="Email phải có đuôi gmail.com">
                </div>
                <span asp-validation-for="Email" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-4 text-start">
                <div class="input-group input-group-custom">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu (ít nhất 6 ký tự) *" required minlength="6">
                </div>
                <span asp-validation-for="Password" class="text-danger small ms-1"></span>
            </div>

            <button type="submit" class="btn btn-brand w-100 mb-3">
                <i class="bi bi-person-plus-fill me-2"></i> Đăng ký
            </button>

        </form>

        <div class="mt-2" style="font-size: 0.95rem;">
            <span class="text-muted">Đã có tài khoản? </span>
            <a asp-controller="Auth" asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--brand-green);">Đăng nhập</a>
        </div>

    </div>
</div>