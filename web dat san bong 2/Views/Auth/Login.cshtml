@model web_dat_san_bong_2.Models.Login
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page-container">
    <div class="auth-card text-center">

        <div class="auth-logo-circle shadow-sm">
            <i class="bi bi-person-fill"></i>
        </div>

        <h3 class="fw-bold mb-2">Đăng nhập</h3>
        <p class="text-muted mb-4" style="font-size: 0.9rem;">Đăng nhập để đặt sân nhanh hơn và xem lịch sử</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-start mb-4 shadow-sm" role="alert" style="border-radius: 10px;">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-start"></div>

        <form asp-controller="Auth" asp-action="Login" method="post">

            <div class="mb-3 text-start">
                <div class="input-group input-group-custom">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Phone" class="form-control" placeholder="Số điện thoại" required>
                </div>
                <span asp-validation-for="Phone" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-4 text-start">
                <div class="input-group input-group-custom">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" required>
                </div>
                <span asp-validation-for="Password" class="text-danger small ms-1"></span>
            </div>

            <button type="submit" class="btn btn-brand w-100 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
            </button>
        </form>

        <div class="mt-3" style="font-size: 0.95rem;">
            <span class="text-muted">Chưa có tài khoản? </span>
            <a asp-controller="Auth" asp-action="Register" class="fw-bold text-decoration-none" style="color: var(--brand-green);">Đăng ký ngay</a>
        </div>

    </div>
</div>