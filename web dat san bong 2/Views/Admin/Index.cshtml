@model IEnumerable<web_dat_san_bong_2.Models.SanTheThao>

@{
    ViewData["Title"] = "Quản lý sân thể thao";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-building"></i> Quản lý sân thể thao</h2>
        <div>
            
            <a asp-action="Create" class="btn btn-brand rounded-3 shadow-sm" style="background-color: var(--brand-green); color: white;">
                <i class="bi bi-plus-circle"></i> Thêm sân mới
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã sân</th>
                        <th>Tên sân</th>
                        <th>Loại sân</th>
                        <th>Giờ hoạt động</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><span class="badge bg-secondary">#@item.MaSan</span></td>
                            <td class="fw-bold text-dark">@item.TenSan</td>
                            <td>@item.LoaiSan</td>

                            <td>@item.GioMo - @item.GioDong</td>

                            <td>
                                @if (item.TrangThai == "Hoạt động")
                                {
                                    <span class="badge bg-success rounded-pill px-3">@item.TrangThai</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3">@item.TrangThai</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@item.MaSan" class="btn btn-sm btn-outline-primary rounded-3 me-1">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <a asp-action="XoaSan" asp-route-id="@item.MaSan" class="btn btn-sm btn-outline-danger rounded-3">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>